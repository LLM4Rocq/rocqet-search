FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

# Slim deps: the 'serve' extra pulls fastembed (ONNX) for query embedding only —
# no torch, no in-process vector DB. Vectors live in managed Qdrant (set
# QDRANT_URL / QDRANT_API_KEY), so the container's memory stays small and stable.
COPY pyproject.toml README.md ./
COPY rocqet ./rocqet
RUN pip install --no-cache-dir ".[serve,flt]"

ENV ROCQET_EMBEDDER=fastembed \
    FASTEMBED_CACHE_PATH=/app/.cache/fastembed

# Pre-download (and cache) the ONNX model at build time so the first query is
# fast and the running container needs no network for embeddings.
RUN python -c "from fastembed import TextEmbedding; \
    list(TextEmbedding('sentence-transformers/all-MiniLM-L6-v2').embed(['warmup']))"

# FLT search data (29,511 theorems + title embeddings, ~213MB). Unlike the
# main index (lives in managed Qdrant), the FLT index is in-memory, so its
# data has to be baked into the image. Distributed via a GitHub Release
# rather than committed — see README.md "FLT search page".
RUN mkdir -p flt/data \
    && curl -fL -o flt/data/theorems.jsonl \
         https://github.com/LLM4Rocq/rocqet-search/releases/download/flt-data-v1/theorems.jsonl \
    && curl -fL -o flt/data/emb_title.npy \
         https://github.com/LLM4Rocq/rocqet-search/releases/download/flt-data-v1/emb_title.npy

EXPOSE 8000
# Railway (and most PaaS) inject $PORT; fall back to 8000 locally.
CMD ["sh", "-c", "uvicorn rocqet.api:app --host 0.0.0.0 --port ${PORT:-8000}"]
